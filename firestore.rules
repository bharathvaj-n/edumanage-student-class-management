rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /batches/{batchId} {
      allow create: if request.auth != null
        && request.resource.data.teacher_id == request.auth.uid;

      allow read: if request.auth != null
        && resource.data.teacher_id == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.teacher_id == request.auth.uid
        && request.resource.data.teacher_id == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.teacher_id == request.auth.uid;
    }

    match /student_data/{studentId} {
      allow create: if request.auth != null
        && request.resource.data.teacher_id == request.auth.uid;

      allow read: if request.auth != null
        && resource.data.teacher_id == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.teacher_id == request.auth.uid
        && request.resource.data.teacher_id == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.teacher_id == request.auth.uid;
    }

    match /class_sessions/{sessionId} {
      allow create: if request.auth != null
        && request.resource.data.teacher_id == request.auth.uid;

      allow read: if request.auth != null
        && resource.data.teacher_id == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.teacher_id == request.auth.uid
        && request.resource.data.teacher_id == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.teacher_id == request.auth.uid;
    }

    match /attendance_data/{attendanceId} {
      allow create: if request.auth != null
        && request.resource.data.teacher_id == request.auth.uid;

      allow read: if request.auth != null
        && resource.data.teacher_id == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.teacher_id == request.auth.uid
        && request.resource.data.teacher_id == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.teacher_id == request.auth.uid;
    }

    match /todolist/{taskId} {
      allow create: if request.auth != null
        && request.resource.data.teacher_id == request.auth.uid;

      allow read: if request.auth != null
        && resource.data.teacher_id == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.teacher_id == request.auth.uid
        && request.resource.data.teacher_id == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.teacher_id == request.auth.uid;
    }

    match /class_data/{classId} {
      allow create: if request.auth != null
        && request.resource.data.teacher_id == request.auth.uid;

      allow read: if request.auth != null
        && resource.data.teacher_id == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.teacher_id == request.auth.uid
        && request.resource.data.teacher_id == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.teacher_id == request.auth.uid;
    }
  }
}
